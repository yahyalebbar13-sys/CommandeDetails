
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin data
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update, delete: if isOwner(userId);

      match /generalCategories/{id} { allow read, write: if isOwner(userId); }
      match /categories/{id} { allow read, write: if isOwner(userId); }
      match /suppliers/{id} { allow read, write: if isOwner(userId); }
      match /articles/{id} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      match /factures/{id} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      match /supplierPayments/{id} { allow read, write: if isOwner(userId); }
    }

    // Client access mapping
    // Write: any authenticated user (UI restricts button to admin only)
    // Read: the client reads their own doc to find their clientName + adminUid
    match /clientAccess/{clientUid} {
      allow read: if isSignedIn() && request.auth.uid == clientUid;
      allow write: if isSignedIn();
    }
  }
}
