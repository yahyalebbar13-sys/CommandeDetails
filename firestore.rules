rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCommercial() {
      return isSignedIn() && request.auth.token.email != null && (
        exists(/databases/$(database)/documents/storeAccess/$(request.auth.token.email)) ||
        exists(/databases/$(database)/documents/storeAccess/$(request.auth.token.email.lower())) ||
        exists(/databases/$(database)/documents/storeAccess/$(request.auth.uid))
      );
    }

    function hasAccess(userId) {
      return isOwner(userId) || isCommercial();
    }

    // ── Isolation par magasin ─────────────────────────────────────────────────
    // Résout le document storeAccess du compte appelant (email brut, email en
    // minuscule, ou uid — mêmes variantes que isCommercial() pour compatibilité
    // avec les données existantes).
    function accessDoc() {
      let email = request.auth.token.email;
      return exists(/databases/$(database)/documents/storeAccess/$(email))
        ? get(/databases/$(database)/documents/storeAccess/$(email)).data
        : exists(/databases/$(database)/documents/storeAccess/$(email.lower()))
          ? get(/databases/$(database)/documents/storeAccess/$(email.lower())).data
          : exists(/databases/$(database)/documents/storeAccess/$(request.auth.uid))
            ? get(/databases/$(database)/documents/storeAccess/$(request.auth.uid)).data
            : null;
    }

    // Un compte storeAccess avec role == 'ADMIN' (responsable multi-magasins)
    // voit tous les magasins, comme l'admin propriétaire.
    function isFullAccessCommercial() {
      let acc = isSignedIn() ? accessDoc() : null;
      return acc != null && acc.get('role', 'COMMERCIAL') == 'ADMIN';
    }

    // Lecture : autorise aussi les documents legacy sans storeId (données
    // partagées ou anciennes, non bloquantes) et les comptes role=ADMIN.
    // isOwner() est vérifié en premier via un ternaire pour ne JAMAIS lire
    // storeAccess sur le chemin le plus fréquent (l'admin propriétaire).
    function canReadStoreScoped(userId, data) {
      let acc = isOwner(userId) ? null : (isSignedIn() ? accessDoc() : null);
      return isOwner(userId) || (acc != null && (
        acc.get('role', 'COMMERCIAL') == 'ADMIN'
        || !('storeId' in data) || data.storeId == null || data.storeId == acc.get('storeId', null)
      ));
    }

    // Création : un simple commercial doit explicitement taguer son propre
    // magasin (pas d'échappatoire "storeId absent" — évite de créer des
    // données globales non attribuées ou d'usurper un autre magasin).
    function canCreateStoreScoped(userId, data) {
      let acc = isOwner(userId) ? null : (isSignedIn() ? accessDoc() : null);
      return isOwner(userId) || (acc != null && (
        acc.get('role', 'COMMERCIAL') == 'ADMIN'
        || ('storeId' in data && data.storeId == acc.get('storeId', null))
      ));
    }

    // Mise à jour : le document doit rester dans le magasin du commercial,
    // avant ET après modification (empêche de déplacer un document vers/hors
    // de son propre magasin).
    function canUpdateStoreScoped(userId, existing, incoming) {
      let acc = isOwner(userId) ? null : (isSignedIn() ? accessDoc() : null);
      return isOwner(userId) || (acc != null && (
        acc.get('role', 'COMMERCIAL') == 'ADMIN'
        || (
          (!('storeId' in existing) || existing.storeId == null || existing.storeId == acc.get('storeId', null))
          && (!('storeId' in incoming) || incoming.storeId == null || incoming.storeId == acc.get('storeId', null))
        )
      ));
    }

    // Transferts : concernent DEUX magasins (source + destination) — un
    // commercial y a accès si l'un des deux est le sien.
    function isOwnTransferDoc(userId, data) {
      let acc = isOwner(userId) ? null : (isSignedIn() ? accessDoc() : null);
      return isOwner(userId) || (acc != null && (
        acc.get('role', 'COMMERCIAL') == 'ADMIN'
        || data.fromStore == acc.get('storeId', null) || data.toStore == acc.get('storeId', null)
      ));
    }

    // ── Global Config ──────────────────────────────────────────────────────────
    match /publicConfig/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
    }

    // ── Store Access ───────────────────────────────────────────────────────────
    match /storeAccess/{email} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
    }

    // ── Admin user document ────────────────────────────────────────────────────
    match /users/{userId} {
      // Only the owner can read/write their own user doc
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update, delete: if isOwner(userId);

      // generalCategories: owner only (internal admin data)
      match /generalCategories/{id} {
        allow read, write: if hasAccess(userId);
      }

      // categories: owner can write; a valid client whose clientAccess.adminUid == userId can read
      match /categories/{id} {
        allow read: if hasAccess(userId)
          || (isSignedIn() && exists(/databases/$(database)/documents/clientAccess/$(request.auth.uid))
              && get(/databases/$(database)/documents/clientAccess/$(request.auth.uid)).data.adminUid == userId);
        allow write: if hasAccess(userId);
      }

      // designs: sub-collection of categories — same access as parent category
      // (owner writes; valid client can read for portal display)
      match /categories/{catId}/designs/{designId} {
        allow read: if hasAccess(userId)
          || (isSignedIn() && exists(/databases/$(database)/documents/clientAccess/$(request.auth.uid))
              && get(/databases/$(database)/documents/clientAccess/$(request.auth.uid)).data.adminUid == userId);
        allow write: if hasAccess(userId);
      }

      // suppliers: owner only (financially sensitive)
      match /suppliers/{id} {
        allow read, write: if hasAccess(userId);
      }

      // articles: owner can write; a valid client whose clientAccess.adminUid == userId can read
      match /articles/{id} {
        allow read: if hasAccess(userId)
          || (isSignedIn() && exists(/databases/$(database)/documents/clientAccess/$(request.auth.uid))
              && get(/databases/$(database)/documents/clientAccess/$(request.auth.uid)).data.adminUid == userId);
        allow write: if hasAccess(userId);
      }

      // factures: owner can write; a valid client whose clientAccess.adminUid == userId can read
      match /factures/{id} {
        allow read: if hasAccess(userId)
          || (isSignedIn() && exists(/databases/$(database)/documents/clientAccess/$(request.auth.uid))
              && get(/databases/$(database)/documents/clientAccess/$(request.auth.uid)).data.adminUid == userId);
        allow write: if hasAccess(userId);
      }

      // supplierPayments: strictly owner only (financial data)
      match /supplierPayments/{id} {
        allow read, write: if hasAccess(userId);
      }

      // dp_declarations: customs declarations, owner only
      match /dp_declarations/{id} {
        allow read, write: if hasAccess(userId);
      }

      // supplierProfiles: fournisseur contact info (adresse, email, tél...), owner only
      match /supplierProfiles/{id} {
        allow read, write: if hasAccess(userId);
      }

      // checklists: dossier verification checklist, owner only
      match /checklists/{id} {
        allow read, write: if hasAccess(userId);
      }

      // stockMovements: journal des entrées/sorties physiques — isolé par magasin
      match /stockMovements/{id} {
        allow read: if canReadStoreScoped(userId, resource.data);
        allow create: if canCreateStoreScoped(userId, request.resource.data);
        allow update: if canUpdateStoreScoped(userId, resource.data, request.resource.data);
        allow delete: if isOwner(userId) || isFullAccessCommercial();
      }

      // sales: transactions de vente rapide — isolé par magasin
      match /sales/{id} {
        allow read: if canReadStoreScoped(userId, resource.data);
        allow create: if canCreateStoreScoped(userId, request.resource.data);
        allow update: if canUpdateStoreScoped(userId, resource.data, request.resource.data);
        allow delete: if isOwner(userId) || isFullAccessCommercial();
      }

      // transferOrders: concerne deux magasins (source + destination)
      match /transferOrders/{id} {
        allow read: if isOwnTransferDoc(userId, resource.data);
        allow create: if isOwnTransferDoc(userId, request.resource.data);
        allow update: if isOwnTransferDoc(userId, resource.data) && isOwnTransferDoc(userId, request.resource.data);
        allow delete: if isOwner(userId) || isFullAccessCommercial();
      }

      // stores: owner can write; a valid client whose clientAccess.adminUid == userId can read
      match /stores/{id} {
        allow read: if hasAccess(userId);
        allow write: if hasAccess(userId);
      }

      // clients: dossier clients — isolé par magasin
      match /clients/{id} {
        allow read: if canReadStoreScoped(userId, resource.data);
        allow create: if canCreateStoreScoped(userId, request.resource.data);
        allow update: if canUpdateStoreScoped(userId, resource.data, request.resource.data);
        allow delete: if isOwner(userId) || isFullAccessCommercial();
      }

      // saleOrders: bons de commande — isolé par magasin
      match /saleOrders/{id} {
        allow read: if canReadStoreScoped(userId, resource.data);
        allow create: if canCreateStoreScoped(userId, request.resource.data);
        allow update: if canUpdateStoreScoped(userId, resource.data, request.resource.data);
        allow delete: if isOwner(userId) || isFullAccessCommercial();
      }

      // invoices: factures de vente — isolé par magasin
      match /invoices/{id} {
        allow read: if canReadStoreScoped(userId, resource.data);
        allow create: if canCreateStoreScoped(userId, request.resource.data);
        allow update: if canUpdateStoreScoped(userId, resource.data, request.resource.data);
        allow delete: if isOwner(userId) || isFullAccessCommercial();
      }

      // clientPayments: paiements clients — isolé par magasin
      match /clientPayments/{id} {
        allow read: if canReadStoreScoped(userId, resource.data);
        allow create: if canCreateStoreScoped(userId, request.resource.data);
        allow update: if canUpdateStoreScoped(userId, resource.data, request.resource.data);
        allow delete: if isOwner(userId) || isFullAccessCommercial();
      }

      // baseOrders: modèles de commandes fixes, owner only
      match /baseOrders/{id} {
        allow read, write: if hasAccess(userId);
      }

      // commercialExpenses: notes de frais des commerciaux — isolé par magasin
      match /commercialExpenses/{id} {
        allow read: if canReadStoreScoped(userId, resource.data);
        allow create: if canCreateStoreScoped(userId, request.resource.data);
        allow update: if canUpdateStoreScoped(userId, resource.data, request.resource.data);
        allow delete: if isOwner(userId) || isFullAccessCommercial();
      }

      // checkRemittances: bordereaux de remise de chèques en banque, owner only
      // (opération de trésorerie centrale, pas rattachée à un magasin unique)
      match /checkRemittances/{id} {
        allow read, write: if hasAccess(userId);
      }

      // auditLog: journal d'audit
      match /auditLog/{id} {
        allow read, write: if hasAccess(userId);
      }
    }

    // ── Client Access mapping ──────────────────────────────────────────────────
    // /clientAccess/{clientUid}
    //   - A client can READ their own document (to discover clientName + adminUid)
    //   - Only the ADMIN identified in the document can WRITE it
    //     (we enforce this by checking that the writer's uid matches request.resource.data.adminUid)
    //   - No one else can read or write
    match /clientAccess/{clientUid} {
      // Client reads their own access doc
      allow get: if isSignedIn() && request.auth.uid == clientUid;

      // Admin can LIST to find clients by clientName (needed for email notifications)
      allow list: if isSignedIn();

      // Admin creates/updates: the writer must be the adminUid stored in the document
      allow create: if isSignedIn()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.keys().hasAll(['clientName', 'adminUid', 'email', 'createdAt']);

      allow update: if isSignedIn()
        // The EXISTING document's adminUid must match the requester (prevents client from hijacking)
        && resource.data.adminUid == request.auth.uid
        // The NEW document must keep the same adminUid (cannot be changed)
        && request.resource.data.adminUid == resource.data.adminUid;

      allow delete: if isSignedIn() && resource.data.adminUid == request.auth.uid;
    }

    // ── E-Commerce Shop Collections ────────────────────────────────────────────

    // shop_products: public read, admin-only write
    match /shop_products/{productId} {
      allow read: if true;  // Public catalog
      allow write: if isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
    }

    // shop_product_overrides: public read (catalog display), admin-only write
    match /shop_product_overrides/{productId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
    }

    // shop_category_overrides: public read, admin-only write
    match /shop_category_overrides/{catId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
    }

    // shop_custom_products: public read, admin-only write
    match /shop_custom_products/{productId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
    }

    // shop_custom_categories: public read, admin-only write
    match /shop_custom_categories/{catId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
    }

    // shop_catalogue_settings: public read, admin-only write
    match /shop_catalogue_settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
    }

    // shop_orders: anyone can create (guest checkout), owner & admin can read/update
    match /shop_orders/{orderId} {
      // Anyone can create an order (guest + logged-in customers)
      allow create: if true;
      // Single order lookup (confirmation page, tracking)
      allow get: if true;
      // Listing: admin can list all, logged-in customer can list their own orders, or limited queries
      allow list: if (isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com')
        || (isSignedIn() && request.auth.token.email != null && resource.data.customerEmail == request.auth.token.email)
        || request.query.limit <= 20;
      // Admin can update (change order status etc.)
      allow update: if isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
      // Admin can delete
      allow delete: if isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
    }

    // shop_reviews: public read, authenticated write (one per product per user)
    match /shop_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // shop_wishlist: owner only
    match /shop_wishlist/{userId}/{productId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // shop_coupons: public read for validation, admin-only write
    match /shop_coupons/{couponId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
    }

    // shop_customers: user reads own profile, admin reads all
    match /shop_customers/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == 'yahya.lebbar13@gmail.com');
    }

    // ── Unified Product Master Database ───────────────────────────────────────
    // products_master: central product registry linking Gestion, Stock & Shop
    match /products_master/{productId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
    }
  }
}
