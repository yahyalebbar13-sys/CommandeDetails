rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * STOKVUE COMMANDES - SECURITY RULES v1.1
     * Mise à jour pour supporter la hiérarchie à 3 niveaux et les permissions de listing.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Racine Utilisateur et Sous-collections ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update, delete: if isOwner(userId);

      // Règles globales pour toutes les sous-collections appartenant à l'utilisateur
      match /generalCategories/{id} { allow read, write: if isOwner(userId); }
      match /categories/{id} { allow read, write: if isOwner(userId); }
      match /suppliers/{id} { allow read, write: if isOwner(userId); }
      match /articles/{id} { allow read, write: if isOwner(userId); }
      match /factures/{id} { 
        allow read, write: if isOwner(userId); 
        match /orderItems/{itemId} { allow read, write: if isOwner(userId); }
      }
    }
  }
}