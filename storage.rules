rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Admin can read/write their own files
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Anyone authenticated can read product images (for client portal)
    match /users/{userId}/articles/{articleId}/product-image {
      allow read: if request.auth != null;
    }

    // Anyone authenticated can read category photos (for client portal)
    match /users/{userId}/categories/{categoryId}/photo {
      allow read: if request.auth != null;
    }
  }
}
