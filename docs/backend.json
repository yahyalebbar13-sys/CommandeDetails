
{
  "entities": {
    "GeneralCategory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GeneralCategory",
      "type": "object",
      "description": "Représente un groupe de haut niveau (ex: Accessoires, Tissus, Mercerie) pour organiser les sous-catégories.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifiant unique."
        },
        "name": {
          "type": "string",
          "description": "Le nom du groupe (ex: TEXTILES)."
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "description": "Désormais considérée comme une Sous-catégorie. Elle est rattachée à une Catégorie Générale.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifiant unique."
        },
        "name": {
          "type": "string",
          "description": "Le nom de la sous-catégorie (e.g., 'Sewing Thread')."
        },
        "generalCategoryId": {
          "type": "string",
          "description": "Référence à la catégorie générale parente."
        }
      },
      "required": [
        "id",
        "name",
        "generalCategoryId"
      ]
    },
    "Supplier": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Supplier",
      "type": "object",
      "description": "Represents a commercial partner or company that provides articles.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Supplier entity."
        },
        "name": {
          "type": "string",
          "description": "The official name of the supplier."
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Facture": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Facture",
      "type": "object",
      "description": "Represents an invoice or a container shipment, which serves to group multiple ordered items. It includes overall shipment details and costs.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Facture (invoice/container). This ID is typically provided by the supplier."
        },
        "supplierId": {
          "type": "string",
          "description": "Reference to the primary Supplier for this facture. (Relationship: Supplier 1:N Facture)"
        },
        "arrivalDate": {
          "type": "string",
          "description": "The estimated or actual date of arrival for the entire shipment associated with this facture.",
          "format": "date"
        },
        "freightCost": {
          "type": "number",
          "description": "The total cost of freight or transport associated with this invoice/container."
        }
      },
      "required": [
        "id",
        "supplierId",
        "arrivalDate",
        "freightCost"
      ]
    },
    "Article": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Article",
      "type": "object",
      "description": "Represents a distinct type of product or item that can be ordered, including its generic name and specific technical specifications. This entity defines a product variant.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Article entity."
        },
        "categoryId": {
          "type": "string",
          "description": "Reference to the Sub-Category (Category name) this article belongs to."
        },
        "generalCategoryId": {
          "type": "string",
          "description": "Reference to the General Category this article belongs to."
        },
        "name": {
          "type": "string",
          "description": "The name or primary description of the article."
        },
        "specs": {
          "type": "string",
          "description": "Detailed specifications or packaging information."
        },
        "color": {
          "type": "string"
        },
        "quantity": {
          "type": "number"
        },
        "unitOfMeasure": {
          "type": "string"
        },
        "purchasePricePerUnit": {
          "type": "number"
        },
        "cubicMeasurement": {
          "type": "number"
        },
        "orderDate": {
          "type": "string",
          "format": "date"
        },
        "arrivalDate": {
          "type": "string",
          "format": "date"
        },
        "supplierId": {
          "type": "string"
        },
        "factureId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["TO_ORDER", "PI", "SHIPPED"],
          "description": "TO_ORDER (Reminder), PI (In Production), SHIPPED (Assigned to Facture)."
        }
      },
      "required": [
        "id",
        "categoryId",
        "name",
        "quantity",
        "status"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
