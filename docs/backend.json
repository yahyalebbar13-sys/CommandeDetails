
{
  "entities": {
    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "description": "Represents a product category.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Supplier": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Supplier",
      "type": "object",
      "description": "Represents a commercial partner.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Facture": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Facture",
      "type": "object",
      "description": "Represents an invoice or container shipment.",
      "properties": {
        "id": {
          "type": "string"
        },
        "supplierId": {
          "type": "string"
        },
        "arrivalDate": {
          "type": "string",
          "format": "date"
        },
        "freightCost": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "supplierId",
        "arrivalDate",
        "freightCost"
      ]
    },
    "Article": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Article",
      "type": "object",
      "description": "Represents a product variant.",
      "properties": {
        "id": {
          "type": "string"
        },
        "categoryId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "specs": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "quantity": {
          "type": "number"
        },
        "unitOfMeasure": {
          "type": "string"
        },
        "purchasePricePerUnit": {
          "type": "number"
        },
        "cubicMeasurement": {
          "type": "number"
        },
        "orderDate": {
          "type": "string",
          "format": "date"
        },
        "arrivalDate": {
          "type": "string",
          "format": "date"
        },
        "supplierId": {
          "type": "string"
        },
        "factureId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["TO_ORDER", "PI", "SHIPPED"]
        }
      },
      "required": [
        "id",
        "categoryId",
        "name",
        "quantity",
        "status"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}/categories/{categoryId}",
        "definition": {
          "entityName": "Category",
          "schema": {
            "$ref": "#/backend/entities/Category"
          },
          "description": "Product categories.",
          "params": [
            { "name": "userId" },
            { "name": "categoryId" }
          ]
        }
      },
      {
        "path": "/users/{userId}/suppliers/{supplierId}",
        "definition": {
          "entityName": "Supplier",
          "schema": {
            "$ref": "#/backend/entities/Supplier"
          },
          "description": "Suppliers.",
          "params": [
            { "name": "userId" },
            { "name": "supplierId" }
          ]
        }
      },
      {
        "path": "/users/{userId}/articles/{articleId}",
        "definition": {
          "entityName": "Article",
          "schema": {
            "$ref": "#/backend/entities/Article"
          },
          "description": "Articles.",
          "params": [
            { "name": "userId" },
            { "name": "articleId" }
          ]
        }
      },
      {
        "path": "/users/{userId}/factures/{factureId}",
        "definition": {
          "entityName": "Facture",
          "schema": {
            "$ref": "#/backend/entities/Facture"
          },
          "description": "Invoices.",
          "params": [
            { "name": "userId" },
            { "name": "factureId" }
          ]
        }
      }
    ]
  }
}
