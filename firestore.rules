
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isMainAdmin() {
      return isSignedIn() && request.auth.token.email == 'yahya.lebbar13@gmail.com';
    }

    // Admin data — only the admin can write; clients can read their admin's data
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update, delete: if isOwner(userId);
      
      match /generalCategories/{id} { allow read, write: if isOwner(userId); }
      match /categories/{id} { allow read, write: if isOwner(userId); }
      match /suppliers/{id} { allow read, write: if isOwner(userId); }
      match /articles/{id} {
        allow read: if isOwner(userId) || isSignedIn();
        allow write: if isOwner(userId);
      }
      match /factures/{id} {
        allow read: if isOwner(userId) || isSignedIn();
        allow write: if isOwner(userId);
      }
      match /supplierPayments/{id} { allow read, write: if isOwner(userId); }
    }

    // Client access mapping — only main admin can create/update; client can read their own doc
    match /clientAccess/{clientUid} {
      allow read: if isSignedIn() && (request.auth.uid == clientUid || isMainAdmin());
      allow create, update: if isMainAdmin();
      allow delete: if isMainAdmin();
    }
  }
}
