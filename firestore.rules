
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update, delete: if isOwner(userId);
      
      match /generalCategories/{id} { allow read, write: if isOwner(userId); }
      match /categories/{id} { allow read, write: if isOwner(userId); }
      match /suppliers/{id} { allow read, write: if isOwner(userId); }
      match /articles/{id} { allow read, write: if isOwner(userId); }
      match /factures/{id} { allow read, write: if isOwner(userId); }
      match /supplierPayments/{id} { allow read, write: if isOwner(userId); }
    }
  }
}
