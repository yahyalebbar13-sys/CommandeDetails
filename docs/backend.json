
{
  "entities": {
    "GeneralCategory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GeneralCategory",
      "type": "object",
      "description": "Represents a high-level product family.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "description": "Represents a product sub-category linked to a general category.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "generalCategoryId": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Supplier": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Supplier",
      "type": "object",
      "description": "Represents a commercial partner.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Facture": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Facture",
      "type": "object",
      "description": "Represents an invoice or container shipment.",
      "properties": {
        "id": { "type": "string" },
        "noBL": { "type": "string" },
        "supplierId": { "type": "string" },
        "arrivalDate": { "type": "string", "format": "date" },
        "shippingDate": { "type": "string", "format": "date" },
        "shippingLine": { "type": "string" },
        "freightCost": { "type": "number" },
        "declaredValue": { "type": "number" }
      },
      "required": ["id", "supplierId", "arrivalDate", "freightCost"]
    },
    "Article": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Article",
      "type": "object",
      "description": "Represents a product variant.",
      "properties": {
        "id": { "type": "string" },
        "generalCategoryId": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "specs": { "type": "string" },
        "color": { "type": "string" },
        "size": { "type": "string" },
        "zipperType": { "type": "string" },
        "slider": { "type": "string" },
        "sliderType": { "type": "string" },
        "quantity": { "type": "number" },
        "unitOfMeasure": { "type": "string" },
        "purchasePricePerUnit": { "type": "number" },
        "cubicMeasurement": { "type": "number" },
        "orderDate": { "type": "string", "format": "date" },
        "arrivalDate": { "type": "string", "format": "date" },
        "supplierId": { "type": "string" },
        "factureId": { "type": "string" },
        "status": { "type": "string", "enum": ["TO_ORDER", "PI", "SHIPPED"] }
      },
      "required": ["id", "categoryId", "name", "quantity", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}/generalCategories/{id}",
        "definition": {
          "entityName": "GeneralCategory",
          "schema": { "$ref": "#/backend/entities/GeneralCategory" },
          "description": "General product families."
        }
      },
      {
        "path": "/users/{userId}/categories/{id}",
        "definition": {
          "entityName": "Category",
          "schema": { "$ref": "#/backend/entities/Category" },
          "description": "Sub-categories."
        }
      },
      {
        "path": "/users/{userId}/suppliers/{id}",
        "definition": {
          "entityName": "Supplier",
          "schema": { "$ref": "#/backend/entities/Supplier" },
          "description": "Suppliers."
        }
      },
      {
        "path": "/users/{userId}/articles/{id}",
        "definition": {
          "entityName": "Article",
          "schema": { "$ref": "#/backend/entities/Article" },
          "description": "Articles."
        }
      },
      {
        "path": "/users/{userId}/factures/{id}",
        "definition": {
          "entityName": "Facture",
          "schema": { "$ref": "#/backend/entities/Facture" },
          "description": "Invoices."
        }
      }
    ]
  }
}
